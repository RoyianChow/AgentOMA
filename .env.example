PHARMACY_ID=00000000-0000-0000-0000-000000000000
NEXT_PUBLIC_APP_URL=http://localhost:3000

DATABASE_URL=postgresql://app_user:password@host:6543/postgres?pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://postgres:password@host:5432/postgres?sslmode=require

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=clinical-documents

CLINICAL_VIEWER_BASE_URL=

# --- Task 10 bounded-AI controls -------------------------------------------
# All default-off. An unconfigured environment has every AI capability disabled.
#
# Global kill switch. When true, every bounded capability is dead regardless of
# its own flag or expiry. This is the lever to pull in an incident.
AI_KILL_SWITCH=false
# AI-RX-06 — synthetic prescription extraction (/pharmacist/rx-intake).
# Synthetic corpus only; this capability has no charter and no approval for any
# real document. Leave false outside a local evaluation session.
RX_INTAKE_SYNTHETIC_ENABLED=false
# Hard expiry for AI-RX-06, YYYY-MM-DD. Past this date the capability disables
# itself and needs deliberate renewal.
RX_INTAKE_EXPIRES_ON=

# One-off only: npm run auth:bootstrap-admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
