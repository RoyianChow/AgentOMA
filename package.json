{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/experiment-sandbox"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:pure": "vitest run --config vitest.pure.config.mts --configLoader native --pool threads --maxWorkers 1",
    "test:self-check": "vitest run src/lib/self-check --config vitest.pure.config.mts --configLoader native --pool threads --maxWorkers 1",
    "test:watch": "vitest",
    "test:db:preflight": "tsx tools/verify-test-db-environment.ts pre-start",
    "test:db:verify": "tsx tools/verify-test-db-environment.ts running",
    "test:db:up": "npm run test:db:preflight && docker compose up -d --wait --force-recreate test-db && npm run test:db:verify",
    "test:db:down": "docker compose down -v",
    "test:db:upgrade": "tsx tools/task-02/run-predecessor-upgrade-harness.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/lib/db/seed.ts",
    "db:seed:demo": "tsx src/lib/db/seed-demo.ts",
    "db:verify": "tsx src/lib/db/verify.ts",
    "db:inspect-tenancy": "tsx src/lib/db/inspect-tenancy.ts",
    "auth:bootstrap-admin": "tsx src/lib/db/bootstrap-admin.ts",
    "sandbox:dev": "npm run dev --workspace @agentoma/experiment-sandbox",
    "sandbox:build": "npm run build --workspace @agentoma/experiment-sandbox",
    "sandbox:test": "npm run test --workspace @agentoma/experiment-sandbox",
    "sandbox:verify-environment": "npm run verify-environment --workspace @agentoma/experiment-sandbox",
    "sandbox:verify-boundary": "npm run verify-boundary --workspace @agentoma/experiment-sandbox",
    "sandbox:verify-artifact": "npm run verify-artifact --workspace @agentoma/experiment-sandbox",
    "sandbox:verify-evidence": "npm run verify-evidence --workspace @agentoma/experiment-sandbox",
    "sandbox:verify-production": "npm run verify-production --workspace @agentoma/experiment-sandbox",
    "sandbox:verify": "npm run verify --workspace @agentoma/experiment-sandbox"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "^0.13.11",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "next": "16.2.10",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
